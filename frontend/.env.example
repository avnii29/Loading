# OpenStreetMap tiles via Leaflet. Mappls is not loaded unless this is set to mappls.
VITE_MAP_PROVIDER=leaflet

# Production API origin, including the /api prefix.
# Leave unset during local Vite dev so requests stay on /api and the dev server proxies them to port 8001.
# Example: https://api.example.com/api
# VITE_API_URL=

# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
