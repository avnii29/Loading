APP_NAME=Anuvarthan API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local development uses the fields below. A hosted database can instead set
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# When DATABASE_URL is set, it is used and the DB_* fields are ignored.
DB_USER=anuvartan
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=anuvartan

JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440
AUTH_COOKIE_NAME=ds_access_token

# Photo files. Empty uses backend/var/uploads. A free web host's disk is wiped on restart.
# UPLOAD_DIR=

# OpenStreetMap via Nominatim + OSRM. Mappls is not used unless MAP_PROVIDER=mappls.
MAP_PROVIDER=osm
MAPPLS_ACCESS_TOKEN=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_REGION=IND
MAPPLS_TIMEOUT_SECONDS=8

# Optional operational overview — not a fake user GPS
# SERVICE_AREA_NAME=Hyderabad
# SERVICE_AREA_CENTER_LAT=17.3850
# SERVICE_AREA_CENTER_LNG=78.4867
# SERVICE_AREA_RADIUS_KM=40
